# Cloudflare Pages response headers (DECISIONS #81). Only the app's own files, and its one Supabase project.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://bqcfdrbnavpsmpgvnitt.supabase.co wss://bqcfdrbnavpsmpgvnitt.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY

# built files carry a content hash in their name, so they never change: cache for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# the service worker and the page itself must always be fresh, or an update never arrives
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
