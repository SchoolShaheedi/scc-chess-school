# The Android app (DECISIONS #121, #123): `vite build --mode native` (native/build-web.mjs). The Supabase address and
# public key come from .env.local like the website's, so the store build has sign-in and online play. For the fully
# offline build (no accounts at all), set VITE_SUPABASE_URL= and VITE_SUPABASE_ANON_KEY= empty here.
VITE_NATIVE=1
